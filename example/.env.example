# Required paths and service identifiers
CONFIG_PATH=/etc/image-updater/config.yaml
AWS_QUEUE_URI=https://sqs.ap-northeast-1.amazonaws.com/123456789012/image-updater
GITHUB_APPLICATION_ID=123456
GITHUB_INSTALLATION_ID=12345678
GITHUB_USERNAME=image-updater
GITHUB_CRT_PATH=/etc/image-updater/private-key.pem

# Optional GitHub settings
GITHUB_AUTHOR_EMAIL=image-updater@users.noreply.github.com
GITHUB_BASE_BRANCH=main

# Optional runtime settings
IMAGE_LABEL_ANNOTATION_ENABLED=false
IMAGE_MANIFEST_INDENT=2
LOG_LEVEL=info
INTERVAL=10s
CONCURRENCY=10
SHUTDOWN_TIMEOUT=30s
AWS_QUEUE_WAIT_TIME=20
AWS_QUEUE_VISIBILITY_TIMEOUT=20
AWS_QUEUE_MAX_MESSAGES=10
